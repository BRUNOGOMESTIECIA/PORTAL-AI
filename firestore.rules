rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regra padrão: nega acesso por padrão (Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    // Regra de Operadores (Apenas usuários autenticados)
    match /operators/{operatorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Regra de Domínios B2B Autorizados (Leitura autenticada)
    match /domains/{domainId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra de Chamados (Tickets)
    match /tickets/{ticketId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Regra de Sessoes de Chat (Live Chat)
    match /chat_sessions/{chatId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // Regra de Contadores Atômicos (#2026XXXX)
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Regra de Trilha de Auditoria ISO 27001
    match /security_audit_logs/{logId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false; // Auditoria Imutável (Nunca pode ser apagada ou editada)
    }

    // Regra de Telemetria de Impressoras e Hardware (Sonda Outbound)
    match /printer_telemetry/{printerId} {
      allow read, write: if true;
    }
    match /equipment_telemetry/{equipId} {
      allow read, write: if true;
    }

    // Regra de Resumos de Big Data
    match /monthly_analytics_aggregates/{monthId} {
      allow read, write: if true;
    }
  }
}
