rules_version = '2';

// =============================================================================
// Firestore Security Rules — Portal IA (portal-ia-784f6)
// Autenticação integrada com InstaPasso SSO
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // TICKETS — Chamados de suporte do sistema
    match /tickets/{ticketId} {
      allow read, write: if true;
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // CHAT SESSIONS — Conversas cliente ↔ operador
    match /chat_sessions/{sessionId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ACTIVE SESSIONS — Sessão única por dispositivo
    match /active_sessions/{userId} {
      allow read, write: if true;
    }

    // AUDIT LOGS — Segurança Máxima (OWASP)
    // Escrita pelo Frontend é PROIBIDA para evitar manipulação de rastros por usuários mal-intencionados.
    // A API (Admin SDK) ignora essas regras e fará as gravações de forma segura.
    match /audit_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
      allow write: if false;
    }

    // USERS — Usuários do sistema
    match /users/{userId} {
      allow read, write: if true;
    }

    // INSTAPASSO COLLECTIONS — Operators e Domains usados no login
    match /operators/{operatorId} {
      allow read, write: if true;
    }
    match /domains/{domainId} {
      allow read, write: if true;
    }

    // Regra padrão de segurança (Fechado por padrão)
    // Protege contra acesso a coleções não explicitamente mapeadas acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
