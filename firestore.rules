rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. REGRA ZERO-TRUST: Bloqueia tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. FUNÇÕES AUXILIARES DE SEGURANÇA
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             request.auth.token.email.matches('.*@tiecia[.]com[.]br$');
    }

    function isOwner(email) {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             request.auth.token.email == email;
    }

    // 3. COLEÇÃO DE TICKETS (CHAMADOS COM ISOLAMENTO MULTI-TENANT)
    match /tickets/{ticketId} {
      // Leitura: Técnicos vêem tudo | Cliente só vê chamados do seu próprio e-mail
      allow read: if isStaff() || (isAuthenticated() && isOwner(resource.data.requesterEmail));
      
      // Criação: Usuário autenticado criando chamado para si mesmo ou Técnico
      allow create: if isStaff() || (
        isAuthenticated() && 
        request.resource.data.requesterEmail == request.auth.token.email &&
        request.resource.data.keys().hasAll(['title', 'status', 'createdAt'])
      );

      // Edição: Técnico pode alterar tudo | Cliente só pode atualizar/comentar no seu próprio ticket
      allow update: if isStaff() || (isAuthenticated() && isOwner(resource.data.requesterEmail));
      
      // Exclusão: Estritamente restrito à equipe interna
      allow delete: if isStaff();
    }

    // 4. COLEÇÃO DE OPERADORES / USUÁRIOS INTERNOS
    match /operators/{operatorId} {
      // Apenas a equipe técnica autenticada pode ler ou gerenciar operadores
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // 5. DOMÍNIOS AUTORIZADOS B2B
    match /domains/{domainId} {
      // Leitura permitida para validação de login SSO | Edição apenas por administradores
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 6. SESSÕES ATIVAS (SEGURANÇA CONTRA CONEXÕES DUPLICADAS)
    match /active_sessions/{userId} {
      // O usuário só acessa e grava na sua própria sessão
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 7. SESSÕES DE CHAT EM TEMPO REAL
    match /chat_sessions/{chatId} {
      // Leitura e Mensagens: Apenas o cliente daquela conversa ou o atendente técnico
      allow read, update: if isStaff() || (
        isAuthenticated() && 
        (resource.data.clientEmail == request.auth.token.email || resource.data.clientId == request.auth.uid)
      );
      
      allow create: if isAuthenticated();
      allow delete: if isStaff();
    }

    // 8. LOGS DE AUDITORIA (ISO 27001 - IMUTÁVEIS)
    match /security_audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isStaff();
      allow update, delete: if false; // NUNCA podem ser alterados ou apagados
    }

    match /audit_logs/{logId} {
      allow create: if true; // Permite registrar logs do sistema e auditorias
      allow read: if isStaff();
      allow update, delete: if false; // Imutabilidade ISO 27001
    }

    // 9. CONTADORES ATÔMICOS (#2026XXXX)
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // 10. PAREAMENTO E DISPOSITIVOS DE EXIBIÇÃO SMART TV (VIDEOWALL NOC PROTEGIDO)
    match /tv_pairing_requests/{code} {
      // A TV só pode criar a solicitação se o status for estritamente 'PENDING' e sem token
      allow create: if request.resource.data.status == 'PENDING'
                    && request.resource.data.code == code
                    && !('deviceToken' in request.resource.data);
      
      // A TV pode escutar se o código dela foi autorizado
      allow read: if true;
      
      // APENAS técnicos TIÉCIA autenticados podem AUTORIZAR a TV (alterar status/token)
      allow update: if isStaff();
      
      // Apenas a equipe técnica pode remover solicitações
      allow delete: if isStaff();
    }

    match /tv_authorized_devices/{deviceId} {
      // A TV pode validar se o token dela é válido
      allow read: if true;
      // Apenas a equipe técnica pode registrar ou revogar TVs autorizadas
      allow write: if isStaff();
    }
  }
}
