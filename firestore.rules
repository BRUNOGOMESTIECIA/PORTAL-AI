rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. REGRA ZERO-TRUST: Bloqueia tudo por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. FUNÇÕES AUXILIARES DE SEGURANÇA
    function isAuthenticated() {
      return request.auth != null;
    }

    // 3. COLEÇÃO DE TICKETS (CHAMADOS)
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && request.auth.token.email.matches('.*@tiecia[.]com[.]br$');
    }

    // 4. COLEÇÃO DE OPERADORES / USUÁRIOS INTERNOS
    match /operators/{operatorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.email.matches('.*@tiecia[.]com[.]br$');
    }

    // 5. DOMÍNIOS AUTORIZADOS B2B
    match /domains/{domainId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.email.matches('.*@tiecia[.]com[.]br$');
    }

    // 6. SESSÕES ATIVAS
    match /active_sessions/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 7. SESSÕES DE CHAT EM TEMPO REAL
    match /chat_sessions/{chatId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && request.auth.token.email.matches('.*@tiecia[.]com[.]br$');
    }

    // 8. LOGS DE AUDITORIA (ISO 27001 - IMUTÁVEIS)
    match /security_audit_logs/{logId} {
      allow create: if true; // Permite registrar inclusive tentativas de login com falha
      allow read: if isAuthenticated() && request.auth.token.email.matches('.*@tiecia[.]com[.]br$');
      allow update, delete: if false; // NUNCA podem ser alterados ou apagados
    }

    // 9. CONTADORES ATÔMICOS (#2026XXXX)
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // 10. TELEMETRIA E HARDWARE
    match /printer_telemetry/{printerId} {
      allow read, write: if isAuthenticated();
    }
    match /equipment_telemetry/{equipId} {
      allow read, write: if isAuthenticated();
    }
    match /monthly_analytics_aggregates/{monthId} {
      allow read, write: if isAuthenticated();
    }
  }
}
