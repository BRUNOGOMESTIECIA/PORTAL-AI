rules_version = '2';

// =============================================================================
// Firestore Security Rules — Portal IA (portal-ia-784f6)
// =============================================================================
// Arquitetura:
//   - A autenticação principal é feita pelo InstaPasso (projeto separado)
//   - O Portal IA usa uma conta de serviço (system_bridge@portal.com) para
//     autorizar operações do sistema após validação pelo InstaPasso
//   - Estas regras são a segunda camada de proteção (defesa em profundidade)
//
// Coleções existentes:
//   • tickets        — chamados abertos por clientes ou operadores
//   • chat_sessions  — sessões de chat entre cliente e operador
//   • users          — usuários clientes cadastrados pelo magic link
//   • audit_logs     — registros imutáveis de ações críticas (futura impl.)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Funções auxiliares
    // =========================================================================

    // Verifica se o usuário está autenticado no Portal IA
    function isAuthenticated() {
      return request.auth != null;
    }

    // A ponte de segurança visual foi removida em favor de Tokens Seguros (NestJS)
    function isSystemBridge() {
      return false;
    }

    // Verifica se o usuário é da equipe pelo Custom Claim (role) injetado via NestJS
    function isStaff() {
      return request.auth != null && 
             (request.auth.token.role == 'staff' || request.auth.token.role == 'Administrator');
    }

    // Verifica se é administrador
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Administrator';
    }

    // Verifica se o usuário é o dono do recurso pelo campo requesterId ou clientId
    function isOwner(resource) {
      return request.auth != null &&
             (request.auth.uid == resource.data.requesterId ||
              request.auth.uid == resource.data.clientId ||
              request.auth.token.email == resource.data.clientEmail);
    }

    // =========================================================================
    // TICKETS — Chamados de suporte
    // =========================================================================
    match /tickets/{ticketId} {
      // Leitura: staff, ou dono do ticket
      allow read: if isStaff() || isOwner(resource);

      // Criação: staff, ou o próprio cliente (se ele for o requester)
      allow create: if isStaff() || (isAuthenticated() && request.auth.uid == request.resource.data.requesterId);

      // Atualização: staff
      allow update: if isStaff();

      // Exclusão: BLOQUEADA
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if isStaff() || isOwner(get(/databases/$(database)/documents/tickets/$(ticketId)));
        allow create: if isStaff() || (isAuthenticated() && isOwner(get(/databases/$(database)/documents/tickets/$(ticketId))));
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // CHAT SESSIONS — Sessões de chat cliente ↔ operador
    // =========================================================================
    match /chat_sessions/{sessionId} {
      allow read: if isStaff() || isOwner(resource);
      
      // Cliente pode iniciar um chat se ele for o client
      allow create: if isStaff() || (isAuthenticated() && request.auth.uid == request.resource.data.clientId);
      
      // Atualização: staff
      allow update: if isStaff();
      
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isStaff() || isOwner(get(/databases/$(database)/documents/chat_sessions/$(sessionId)));
        allow create: if isStaff() || (isAuthenticated() && isOwner(get(/databases/$(database)/documents/chat_sessions/$(sessionId))));
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // ACTIVE SESSIONS — Controle de Sessão Única e Dispositivo
    // =========================================================================
    match /active_sessions/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isStaff();
    }

    // =========================================================================
    // USERS — Usuários
    // =========================================================================
    match /users/{userId} {
      allow read: if isStaff() || request.auth.uid == userId;
      // APENAS A API (NestJS Admin SDK) pode criar usuários
      allow create: if false;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // AUDIT LOGS — Registros imutáveis de ações críticas
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Apenas API/Cloud Functions escrevem aqui
    }

    // =========================================================================
    // Regra padrão de segurança
    // =========================================================================
    // Qualquer coleção não listada acima é BLOQUEADA por padrão
    // Isso garante que novas coleções criadas acidentalmente não fiquem expostas
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
