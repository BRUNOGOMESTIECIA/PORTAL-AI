# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Firebase (Portal IA)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase (InstaPasso)
VITE_INSTAPASSO_API_KEY=
VITE_INSTAPASSO_AUTH_DOMAIN=
VITE_INSTAPASSO_PROJECT_ID=
VITE_INSTAPASSO_STORAGE_BUCKET=
VITE_INSTAPASSO_MESSAGING_SENDER_ID=
VITE_INSTAPASSO_APP_ID=

# Credenciais da Ponte de Segurança (System Bridge)
VITE_BRIDGE_EMAIL=
VITE_BRIDGE_PASS=

# Senha padrão para login de clientes via Magic Link
VITE_CLIENT_MOCK_PASS=
