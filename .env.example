# ─── APPLICATION ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_DOMAIN=empresa.com.br
MASTER_ADMIN_EMAIL=admin@empresa.com.br
MASTER_ADMIN_PASSWORD=change_me_strong_password

# ─── MASTER DATABASE ────────────────────────────────────────────────────────────
MASTER_DB_HOST=postgres
MASTER_DB_PORT=5432
MASTER_DB_NAME=portal_master
MASTER_DB_USER=portal_master_user
MASTER_DB_PASSWORD=change_me_master_db_password

# ─── TENANT DATABASE (template credentials, overridden per tenant) ────────────
TENANT_DB_HOST=postgres
TENANT_DB_PORT=5432
TENANT_DB_USER_PREFIX=tenant_
# Passwords encrypted with this key (AES-256)
DB_ENCRYPTION_KEY=change_me_32_char_encryption_key_

# ─── REDIS ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_jwt_access_secret_min_32chars
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── MINIO (file storage) ───────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=portal-uploads
# Signed URL TTL in seconds (1 hour)
MINIO_PRESIGNED_TTL=3600

# ─── SMTP (transactional email) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@empresa.com.br
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM_NAME=Portal ITSM
SMTP_FROM_EMAIL=noreply@empresa.com.br

# ─── AI ─────────────────────────────────────────────────────────────────────────
# Provider: openai | anthropic
AI_PROVIDER=openai
AI_API_KEY=sk-change_me
AI_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_MS=10000
AI_MAX_INPUT_CHARS=4000

# ─── SSO (optional global defaults, can be overridden per tenant) ───────────────
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://app.empresa.com.br/auth/google/callback

# Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=https://app.empresa.com.br/auth/microsoft/callback

# ─── TRAEFIK ────────────────────────────────────────────────────────────────────
ACME_EMAIL=admin@empresa.com.br

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (in addition to *.APP_DOMAIN)
CORS_EXTRA_ORIGINS=http://localhost:5173,http://localhost:3000
